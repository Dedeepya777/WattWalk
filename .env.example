# WattWalk environment variables. Copy to .env and fill values locally. Never commit .env.
# Keys come from running /costar-keys in the CoStar track Discord channel.

# Modes (see shared/integration.md section 5)
WATTWALK_DATA_MODE=fixture
WATTWALK_VISION_MODE=fixture
WATTWALK_AGENT_MODE=scripted
WATTWALK_AUDITS_DIR=

# Matterport Model API (HTTP basic auth: key = user, token = password)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=

# Vexcel (header x-api-key)
VEXCEL_API_KEY=

# CoStar data kit (download link and zip password from the CoStar keys card).
# Full path to the downloaded zip, for example
#   Windows: C:\Users\<you>\Downloads\costar_kit.zip
#   macOS:   /Users/<you>/Downloads/costar_kit.zip
# An extracted folder path is also accepted.
COSTAR_KIT_ZIP=
COSTAR_ZIP_PASSWORD=

# Amazon Bedrock (standard AWS credential chain; region below)
AWS_REGION=us-east-1
# Amazon Bedrock model ids (not Ollama names)
WATTWALK_SMALL_VISION_MODEL_ID=
WATTWALK_LARGE_VISION_MODEL_ID=
# Planner for WATTWALK_AGENT_MODE=deep_agents: a Bedrock model id with tool use through Converse,
# or openrouter/<model> (needs OPENROUTER_API_KEY and langchain-openai). Check: python -m wattwalk.agent.deep ping
WATTWALK_PLANNER_MODEL_ID=

# OpenRouter (free hosted models; only needed for openrouter/ model ids)
OPENROUTER_API_KEY=

# Frontend (Vite reads variables prefixed VITE_)
VITE_API_BASE=http://localhost:8000
# Matterport Showcase SDK key for the 3D viewer.
# Must allow http://localhost:5173 (and the demo origin) in the Matterport key settings.
VITE_MATTERPORT_SDK_KEY=
