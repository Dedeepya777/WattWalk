# WattWalk environment variables. Copy to .env and fill values locally. Never commit .env.
# Keys come from running /costar-keys in the CoStar track Discord channel.

# Modes (see shared/integration.md section 5)
WATTWALK_DATA_MODE=fixture
WATTWALK_VISION_MODE=fixture
WATTWALK_AGENT_MODE=scripted
WATTWALK_AUDITS_DIR=

# Matterport Model API (HTTP basic auth: key = user, token = password)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Showcase SDK key for the 3D viewer, if the hackathon provides one (unknown at planning time)
MATTERPORT_SDK_KEY=

# Vexcel (header x-api-key)
VEXCEL_API_KEY=

# CoStar data kit (download link and zip password from the CoStar keys card)
COSTAR_KIT_ZIP=
COSTAR_ZIP_PASSWORD=

# Amazon Bedrock (standard AWS credential chain; region below)
AWS_REGION=us-east-1
WATTWALK_SMALL_VISION_MODEL_ID=
WATTWALK_LARGE_VISION_MODEL_ID=
WATTWALK_PLANNER_MODEL_ID=
# Model ids may also be "ollama/<model>" (local Ollama; the planner model must support tool calling,
# e.g. ollama/qwen3:8b) or "gemini/<model>" (Google Gemini API, free key from aistudio.google.com;
# set GOOGLE_API_KEY). GEMINI_MIN_INTERVAL_S spaces vision calls for free-tier rate limits.
OLLAMA_BASE_URL=http://localhost:11434
GOOGLE_API_KEY=
GEMINI_MIN_INTERVAL_S=4

# Frontend (Vite reads variables prefixed VITE_)
VITE_API_BASE=http://localhost:8000
VITE_MATTERPORT_SDK_KEY=
